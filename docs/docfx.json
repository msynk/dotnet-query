{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "DotNetQuery/DotNetQuery.csproj",
            "adapters/DotNetQuery.Blazor/DotNetQuery.Blazor.csproj",
            "adapters/DotNetQuery.Avalonia/DotNetQuery.Avalonia.csproj",
            "persistence/DotNetQuery.Persistence.Sqlite/DotNetQuery.Persistence.Sqlite.csproj",
            "persistence/DotNetQuery.Persistence.Redis/DotNetQuery.Persistence.Redis.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "*.md", "toc.yml" ],
        "exclude": [ "README.md", "_site/**" ]
      },
      {
        "files": [ "api/**.yml", "api/index.md" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "DotNetQuery",
      "_appTitle": "DotNetQuery",
      "_appFooter": "DotNetQuery - server-state management for .NET. MIT licensed.",
      "_enableSearch": true
    }
  }
}
