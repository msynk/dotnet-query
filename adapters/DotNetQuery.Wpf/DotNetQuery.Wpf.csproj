<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>DotNetQuery.Wpf</PackageId>
    <Description>WPF adapter for DotNetQuery: dispatcher-aware helpers and re-exported MVVM bindings (ObservableQuery/ObservableMutation) for XAML data binding.</Description>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetQuery.Core\DotNetQuery.Core.csproj" />
    <ProjectReference Include="..\DotNetQuery.Mvvm\DotNetQuery.Mvvm.csproj" />
  </ItemGroup>

</Project>
