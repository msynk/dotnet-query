<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runtime tests of the WPF and WinUI lifecycle classes (Windows only). The WPF tests drive a real
       System.Windows.Application on an STA thread; the WinUI mapping is tested without a window, since a
       WinUI window needs the Windows App runtime. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" ExcludeAssets="build;buildTransitive;buildMultitargeting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetQuery\DotNetQuery.csproj" />
    <ProjectReference Include="..\..\src\adapters\DotNetQuery.Wpf\DotNetQuery.Wpf.csproj" />
    <ProjectReference Include="..\..\src\adapters\DotNetQuery.WinUI\DotNetQuery.WinUI.csproj" />
  </ItemGroup>

</Project>
