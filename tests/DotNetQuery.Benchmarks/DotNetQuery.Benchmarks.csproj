<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Benchmarks are never packaged, documented, or AOT-published. -->
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires an optimized build; guard against accidental Debug runs. -->
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
    <!-- Comparison baseline for CacheComparisonBenchmarks. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <!-- Renderer for BlazorRenderBenchmarks; AngleSharp lifted past GHSA-pgww-w46g-26qg as in the bUnit tests. -->
    <PackageReference Include="bunit" Version="1.40.0" />
    <PackageReference Include="AngleSharp" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetQuery\DotNetQuery.csproj" />
    <ProjectReference Include="..\..\src\adapters\DotNetQuery.Blazor\DotNetQuery.Blazor.csproj" />
  </ItemGroup>

</Project>
