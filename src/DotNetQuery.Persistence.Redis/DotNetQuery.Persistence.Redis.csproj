<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery.Persistence.Redis</PackageId>
    <Description>Redis cache persistence for DotNetQuery: a StackExchange.Redis-backed IQueryPersister that stores query data in a single Redis hash, for shared/server-side durable caching.</Description>
    <!-- Trim/AOT-safe: persisted envelopes use source-generated JSON (PersistedQueryJson). -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery\DotNetQuery.csproj" />
  </ItemGroup>

</Project>
