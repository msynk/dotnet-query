<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery</PackageId>
    <Description>Server-state management for .NET: fetching, caching, deduplication, retries, invalidation, mutations, infinite and streaming queries, offline support. Includes AddDotNetQuery for Microsoft.Extensions.DependencyInjection, cache persistence (in-memory and file system) with the durable mutation queue, HTTP/JSON and GraphQL fetchers, MVVM bindings (ObservableQuery/ObservableMutation) and the DevTools model. Zero UI dependencies.</Description>
    <!-- Trim/AOT-safe: persisted envelopes use source-generated JSON; the reflection-based JSON overloads
         (Http, GraphQL, persistence registration, DevTools previews/export) are annotated. -->
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <!-- Match the Microsoft.Extensions version to each target framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>

</Project>
