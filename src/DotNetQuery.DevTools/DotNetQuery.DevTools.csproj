<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery.DevTools</PackageId>
    <Description>Framework-agnostic developer tools for DotNetQuery: inspect the query cache, monitor a live event log with timings, invoke manual actions (invalidate/refetch/remove), and export diagnostics. Any UI adapter can render this model.</Description>
    <!-- Uses reflection-based System.Text.Json for the diagnostics export. -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery.Core\DotNetQuery.Core.csproj" />
  </ItemGroup>

</Project>
