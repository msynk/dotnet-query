<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery.Persistence</PackageId>
    <Description>Pluggable cache persistence for DotNetQuery: persist and restore query data across sessions (in-memory and file-system providers included).</Description>
    <!-- Trim/AOT-safe: envelopes use source-generated JSON; reflection-based Register<T> overloads are annotated. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery.Core\DotNetQuery.Core.csproj" />
  </ItemGroup>

</Project>
