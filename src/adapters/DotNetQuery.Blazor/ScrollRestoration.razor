@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Invisible component: remembers the scroll position of the page (or of the element matching Selector) under Id and
   restores it when the view renders again - with cached query data, returning to a long list lands where you left. *@

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _tracking;
    private bool _restored;

    /// <summary>Identifies the view whose scroll position is remembered (for example the list's query key text).</summary>
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;

    /// <summary>A CSS selector of the scrolling element; the window when omitted.</summary>
    [Parameter] public string? Selector { get; set; }

    /// <summary>Restore once this is true - set it when the data that gives the content its height has rendered.</summary>
    [Parameter] public bool Ready { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DotNetQuery.Blazor/dotnetquery-scroll.js");
                _tracking = await _module.InvokeAsync<IJSObjectReference>("track", Id, Selector);
            }

            if (!_restored && Ready && _module is not null)
            {
                _restored = true;
                await _module.InvokeAsync<bool>("restore", Id, Selector);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            // Prerendering (no browser) or the circuit is gone.
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_tracking is not null)
            {
                await _tracking.InvokeVoidAsync("dispose");
                await _tracking.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // Circuit already gone.
        }
    }
}
