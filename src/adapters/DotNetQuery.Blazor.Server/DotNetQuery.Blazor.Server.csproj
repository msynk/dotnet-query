<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Msynk.DotNetQuery.Blazor.Server</PackageId>
    <Description>Blazor Server (interactive server rendering) integration for DotNetQuery: refetches the stale queries a user is looking at when a dropped circuit connection comes back. Server-only (references the ASP.NET Core shared framework), so it lives outside the WebAssembly-compatible Msynk.DotNetQuery.Blazor package.</Description>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetQuery\DotNetQuery.csproj" />
  </ItemGroup>

</Project>
