<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Msynk.DotNetQuery.Wpf</PackageId>
    <Description>WPF adapter for DotNetQuery: dispatcher-aware helpers and re-exported MVVM bindings (ObservableQuery/ObservableMutation) for XAML data binding.</Description>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <IsAotCompatible>false</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DotNetQuery\DotNetQuery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DotNetQuery.Desktop.Tests" />
  </ItemGroup>

</Project>
