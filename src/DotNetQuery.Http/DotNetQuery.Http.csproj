<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery.Http</PackageId>
    <Description>HTTP/JSON transport conveniences for DotNetQuery: build query fetchers from an HttpClient and fetch JSON endpoints directly into the cache. The core stays transport-agnostic; this is ergonomics.</Description>
    <!-- Trim/AOT-safe via the JsonTypeInfo<T> overloads; reflection-based overloads are annotated. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery.Core\DotNetQuery.Core.csproj" />
  </ItemGroup>

</Project>
