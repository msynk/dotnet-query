<!-- Razor SDK so the IndexedDB JS module ships as a static web asset under _content/. -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>DotNetQuery.Persistence.BlazorWasm</PackageId>
    <Description>Browser cache persistence for DotNetQuery in Blazor WebAssembly: IJSRuntime-backed IQueryPersister providers over localStorage and IndexedDB that survive page reloads. Also usable from Blazor Server (via JS interop).</Description>
    <!-- Trim/AOT-safe: persisted envelopes use source-generated JSON (PersistedQueryJson). -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePublicApiAnalyzer>true</EnablePublicApiAnalyzer>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.JSInterop" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.JSInterop" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetQuery.Persistence\DotNetQuery.Persistence.csproj" />
  </ItemGroup>

</Project>
