<Project>

  <PropertyGroup>
    <!-- Each project declares its own TargetFramework(s); this avoids a singular default
         silently overriding a multi-targeting project's TargetFrameworks. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Product>DotNetQuery</Product>
    <Authors>DotNetQuery</Authors>
    <Company>DotNetQuery</Company>
    <VersionPrefix>0.7.0</VersionPrefix>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) DotNetQuery contributors</Copyright>
    <PackageProjectUrl>https://github.com/dotnetquery/dotnetquery</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnetquery/dotnetquery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>server-state;cache;query;data-fetching;async;tanstack;caching;http;api</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup Label="Reproducible packaging">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Ship the README and icon inside every package (harmless for non-packable projects). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
